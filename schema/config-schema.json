{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkConfig",
  "description": "Top-level benchmark configuration: one or more named targets, shared settings, and the payloads run against every target.",
  "type": "object",
  "required": [
    "payloads",
    "settings",
    "targets"
  ],
  "properties": {
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PayloadSpec"
      }
    },
    "settings": {
      "$ref": "#/definitions/Settings"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NamedTarget"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "FieldAssertion": {
      "description": "A per-field assertion in a validation spec.",
      "oneOf": [
        {
          "description": "Key exists (any value, including null).",
          "type": "string",
          "enum": [
            "present"
          ]
        },
        {
          "description": "Field is explicitly `null`.",
          "type": "string",
          "enum": [
            "null"
          ]
        },
        {
          "description": "Field exists and is not `null`.",
          "type": "string",
          "enum": [
            "not_null"
          ]
        },
        {
          "description": "Exact value match.",
          "type": "object",
          "required": [
            "eq"
          ],
          "properties": {
            "eq": true
          },
          "additionalProperties": false
        },
        {
          "description": "JSON type: `\"string\"`, `\"number\"`, `\"boolean\"`, `\"array\"`, `\"object\"`, `\"null\"`.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "String field matches a POSIX ERE.",
          "type": "object",
          "required": [
            "matches"
          ],
          "properties": {
            "matches": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Numeric field within `[min, max]` (both bounds optional).",
          "type": "object",
          "required": [
            "range"
          ],
          "properties": {
            "range": {
              "type": "object",
              "properties": {
                "max": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "min": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Array has exactly N elements.",
          "type": "object",
          "required": [
            "array_length"
          ],
          "properties": {
            "array_length": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Value is present in an array.",
          "type": "object",
          "required": [
            "array_contains"
          ],
          "properties": {
            "array_contains": true
          },
          "additionalProperties": false
        }
      ]
    },
    "HealthCheckConfig": {
      "description": "Health check configuration: poll a URL until it responds 200.",
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1.0
        },
        "timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1.0
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HookCommand": {
      "description": "A shell command to execute as a lifecycle hook.",
      "type": "object",
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "type": "string"
        },
        "timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1.0
        },
        "working_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HttpMethod": {
      "description": "An HTTP request method. The enum makes an invalid method unrepresentable — a bad value fails to deserialize rather than passing through to `validate`.",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ]
    },
    "LifecycleHooks": {
      "description": "Per-target setup, teardown, and health-check hooks.",
      "type": "object",
      "properties": {
        "health_check": {
          "anyOf": [
            {
              "$ref": "#/definitions/HealthCheckConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "teardown": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookCommand"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LoadMode": {
      "description": "Load control mode for pacing request dispatch, tagged on `mode`. Positivity of the float fields is checked in `validate`.",
      "oneOf": [
        {
          "description": "No throttling — fire as fast as concurrency allows.",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "unthrottled"
              ]
            }
          }
        },
        {
          "description": "Constant RPM — pace iterations at a fixed rate.",
          "type": "object",
          "required": [
            "mode",
            "target_rpm"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "constant_rpm"
              ]
            },
            "target_rpm": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Ramp-up — linearly increase RPM from start to end over a duration.",
          "type": "object",
          "required": [
            "duration_secs",
            "end_rpm",
            "mode",
            "start_rpm"
          ],
          "properties": {
            "duration_secs": {
              "type": "number",
              "format": "double"
            },
            "end_rpm": {
              "type": "number",
              "format": "double"
            },
            "mode": {
              "type": "string",
              "enum": [
                "ramp_up"
              ]
            },
            "start_rpm": {
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Step load — sequential steps, each with its own RPM and duration.",
          "type": "object",
          "required": [
            "mode",
            "steps"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "step_load"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LoadStep"
              }
            }
          }
        },
        {
          "description": "Poisson-distributed load at a target mean RPM.",
          "type": "object",
          "required": [
            "mode",
            "target_rpm"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "poisson_rpm"
              ]
            },
            "target_rpm": {
              "type": "number",
              "format": "double"
            }
          }
        }
      ]
    },
    "LoadStep": {
      "description": "A single step in a step-load profile.",
      "type": "object",
      "required": [
        "duration_secs",
        "rpm"
      ],
      "properties": {
        "duration_secs": {
          "type": "number",
          "format": "double"
        },
        "rpm": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "LogLevel": {
      "description": "Log levels for controlling output verbosity. Defaults to `Info`.",
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "NamedTarget": {
      "description": "A single named target in a benchmark run.",
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/definitions/LifecycleHooks"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PayloadSpec": {
      "description": "A specification for a single HTTP payload within a benchmark.",
      "type": "object",
      "required": [
        "method",
        "name",
        "path"
      ],
      "properties": {
        "body": true,
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "method": {
          "$ref": "#/definitions/HttpMethod"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "validate": {
          "anyOf": [
            {
              "$ref": "#/definitions/ValidationSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RetrySettings": {
      "description": "Retry configuration for failed requests.",
      "type": "object",
      "properties": {
        "backoff_multiplier": {
          "description": "Delay multiplier for exponential backoff; must be ≥ 1.0 (checked in `validate`).",
          "default": 2.0,
          "type": "number",
          "format": "double"
        },
        "initial_delay_ms": {
          "default": 1000,
          "type": "integer",
          "format": "uint32",
          "minimum": 1.0
        },
        "max_attempts": {
          "description": "Maximum retry attempts; 0 disables retries.",
          "default": 3,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Settings": {
      "description": "Runtime settings controlling iterations, concurrency, timeouts, and optional features. Real defaults stand in for absent optional sections.",
      "type": "object",
      "required": [
        "concurrency",
        "iterations"
      ],
      "properties": {
        "concurrency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1.0
        },
        "iterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1.0
        },
        "load_mode": {
          "default": {
            "mode": "unthrottled"
          },
          "allOf": [
            {
              "$ref": "#/definitions/LoadMode"
            }
          ]
        },
        "log_level": {
          "default": "info",
          "allOf": [
            {
              "$ref": "#/definitions/LogLevel"
            }
          ]
        },
        "max_connections": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1.0
        },
        "request_timeout_secs": {
          "default": 30,
          "type": "integer",
          "format": "uint32",
          "minimum": 1.0
        },
        "retry": {
          "default": {
            "backoff_multiplier": 2.0,
            "initial_delay_ms": 1000,
            "max_attempts": 3
          },
          "allOf": [
            {
              "$ref": "#/definitions/RetrySettings"
            }
          ]
        },
        "secrets": {
          "type": [
            "string",
            "null"
          ]
        },
        "tempo": {
          "anyOf": [
            {
              "$ref": "#/definitions/TempoSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "warmup": {
          "default": {
            "iterations": 1
          },
          "allOf": [
            {
              "$ref": "#/definitions/WarmupSettings"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TempoSettings": {
      "description": "Optional Tempo (distributed-tracing) integration settings.",
      "type": "object",
      "required": [
        "service_name",
        "url"
      ],
      "properties": {
        "auth_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "description": "Defaults to true when the `tempo` section is present.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "service_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ValidationSpec": {
      "description": "Declarative validation rules applied to every response for an endpoint.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "Map from dot-path (e.g. `$.user.id`) to assertion.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/FieldAssertion"
          }
        },
        "status": {
          "description": "Expected HTTP status code.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WarmupSettings": {
      "description": "Warmup configuration before benchmark runs.",
      "type": "object",
      "properties": {
        "iterations": {
          "description": "Warmup requests per endpoint; 0 disables warmup.",
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}