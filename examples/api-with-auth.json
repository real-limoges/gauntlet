{
  "targets": [
    {
      "name": "production",
      "url": "https://api.production.com"
    },
    {
      "name": "staging",
      "url": "https://api.staging.com"
    }
  ],
  "settings": {
    "iterations": 2000,
    "concurrency": 25,
    "secrets": ".secrets/api-token.txt",
    "max_connections": 50,
    "request_timeout_secs": 45,
    "log_level": "info",
    "warmup": {
      "iterations": 5
    },
    "retry": {
      "max_attempts": 5,
      "initial_delay_ms": 500,
      "backoff_multiplier": 1.5
    }
  },
  "payloads": [
    {
      "name": "authenticated-api-call",
      "method": "GET",
      "path": "/api/v2/user/profile",
      "headers": {
        "X-API-Key": "your-api-key-here",
        "X-Request-ID": "benchmark-test-001",
        "Accept": "application/json"
      }
    },
    {
      "name": "post-with-custom-content-type",
      "method": "POST",
      "path": "/api/v2/data/upload",
      "headers": {
        "Content-Type": "application/x-custom-format",
        "X-Client-Version": "2.0.0"
      },
      "body": {
        "timestamp": "2026-02-16T10:00:00Z",
        "data": {
          "metrics": [
            1,
            2,
            3,
            4,
            5
          ]
        }
      }
    }
  ]
}
