#!/usr/bin/env bash
# Pre-push gate: the same three checks CI runs, in the order that fails fastest.
set -euo pipefail

echo "==> cargo fmt --check"
if ! cargo fmt --all --check; then
    echo "formatting differs — run 'make format', re-stage, and retry"
    exit 1
fi

echo "==> cargo clippy (warnings denied)"
cargo clippy --workspace --all-targets -- -D warnings

echo "==> cargo test"
cargo test --workspace
