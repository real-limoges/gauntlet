#!/usr/bin/env bash
# Pre-push gate: the same checks CI runs, in the order that fails fastest.
# Mirror of `make check` and .github/workflows/ci.yml; keep the three in step.
set -euo pipefail

echo "==> cargo fmt --check"
if ! cargo fmt --all --check; then
    echo "formatting differs — run 'make format', re-stage, and retry"
    exit 1
fi

echo "==> cargo clippy (warnings denied)"
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings

echo "==> cargo doc (broken intra-doc links denied)"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked

echo "==> cargo test"
cargo test --workspace --all-features --locked
